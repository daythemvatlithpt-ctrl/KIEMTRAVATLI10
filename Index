      const typeLabels = {
        'MC': 'Trắc Nghiệm 4 Phương Án',
        'TF_CLUSTER': 'Đúng / Sai Cụm Ý',
        'SHORT_ANS': 'Trả Lời Ngắn (Điền Số)',
        'MATCH': 'Ghép Nối Cột Tương Ứng',
        'FILL_BLANK': 'Điền Khuyết Từ Khóa'
      };

      let bodyHtml = '';
      if (q.type === 'MC') {
        bodyHtml = `
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
            ${q.options.map((opt, optIdx) => `
              <label class="flex items-center gap-3 p-4 rounded-2xl border border-slate-200 hover:border-blue-400 hover:bg-blue-50/50 cursor-pointer transition select-none group">
