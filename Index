        roleBadge.textContent = "Giáo Viên";
        roleIcon.className = "w-12 h-12 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-2xl font-bold";
        roleIcon.textContent = "👨‍🏫";
        greetingTitle.textContent = "Trung Tâm Thống Kê Điểm & Quản Trị Đề Thi";
        if (oralBtn) oralBtn.classList.remove('hidden');
        document.getElementById('dash-tab-group').classList.remove('hidden');
        document.getElementById('dash-tab-editor').classList.remove('hidden');
        switchDashboardTab('personal');
      }

      loadDashboardData();
    }

    function switchDashboardTab(tabName) {
      document.querySelectorAll('.dash-tab-btn').forEach(btn => {
        btn.classList.remove('border-blue-600', 'text-blue-600');
        btn.classList.add('border-transparent', 'text-slate-500');
      });
      document.querySelectorAll('.dash-tab-content').forEach(c => c.classList.add('hidden'));

      if (tabName === 'group') {
        document.getElementById('dash-tab-group').classList.add('border-blue-600', 'text-blue-600');
        document.getElementById('dash-content-group').classList.remove('hidden');
        loadDashboardData();
      } else if (tabName === 'personal') {
        document.getElementById('dash-tab-personal').classList.add('border-blue-600', 'text-blue-600');
        document.getElementById('dash-content-personal').classList.remove('hidden');
        loadDashboardData();
      } else if (tabName === 'editor') {
        document.getElementById('dash-tab-editor').classList.add('border-blue-600', 'text-blue-600');
        document.getElementById('dash-content-editor').classList.remove('hidden');
        loadEditorLessonQuestions();
      }
    }

    function loadDashboardData() {
      const filterClass = document.getElementById('filter-class').value;
      const filterLesson = document.getElementById('filter-lesson').value;
      const searchStr = (document.getElementById('filter-student-search')?.value || '').trim().toLowerCase();

      let personalList = [];
      try { personalList = JSON.parse(localStorage.getItem(RESULTS_PERSONAL_KEY)) || []; } catch (e) {}

      let filteredPersonal = personalList.filter(item => {
        const matchClass = filterClass === 'ALL' || item.className === filterClass;
        const matchLesson = filterLesson === 'ALL' || String(item.lessonId) === String(filterLesson);
        const matchSearch = !searchStr || item.name.toLowerCase().includes(searchStr);
        return matchClass && matchLesson && matchSearch;
      });

      filteredPersonal.sort((a, b) => b.score10 - a.score10);
      document.getElementById('badge-student-count').textContent = filteredPersonal.length;

      const pTbody = document.getElementById('personal-stats-tbody');
      pTbody.innerHTML = '';
      if (filteredPersonal.length === 0) {
        pTbody.innerHTML = `<tr><td colspan="8" class="py-8 text-center text-slate-400">Không có dữ liệu bài thi phù hợp.</td></tr>`;
      } else {
        filteredPersonal.forEach((item, idx) => {
          let rankBadge = `#${idx + 1}`;
          if (idx === 0) rankBadge = `🥇 #1`;
          else if (idx === 1) rankBadge = `🥈 #2`;
          else if (idx === 2) rankBadge = `🥉 #3`;

          const row = document.createElement('tr');
          row.className = "hover:bg-slate-50 transition";
          row.innerHTML = `
            <td class="py-3 px-4 font-black text-amber-600">${rankBadge}</td>
            <td class="py-3 px-4 font-bold text-slate-800">${item.name}</td>
            <td class="py-3 px-4 font-extrabold text-indigo-700">${item.className}</td>
            <td class="py-3 px-4 font-medium text-slate-600 text-xs">${item.lessonTitle}</td>
            <td class="py-3 px-4 text-center font-mono font-black text-blue-600 text-base">${item.score10.toFixed(2)}</td>
            <td class="py-3 px-4 text-center font-medium text-slate-600">${item.timeStr || '--'}</td>
            <td class="py-3 px-4 text-center"><span class="px-2 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-700">Đã hoàn thành</span></td>
            <td class="py-3 px-4 text-right text-xs text-slate-400">${item.timestamp}</td>
          `;
          pTbody.appendChild(row);
        });
      }

      let groupList = [];
      try { groupList = JSON.parse(localStorage.getItem(RESULTS_GROUP_KEY)) || []; } catch (e) {}

      let filteredGroup = groupList.filter(item => {
        const matchClass = filterClass === 'ALL' || item.className === filterClass;
        const matchLesson = filterLesson === 'ALL' || String(item.lessonId) === String(filterLesson);
        return matchClass && matchLesson;
      });

      filteredGroup.sort((a, b) => b.score10 - a.score10);
      document.getElementById('badge-group-count').textContent = filteredGroup.length;

      const gTbody = document.getElementById('group-stats-tbody');
      gTbody.innerHTML = '';
      if (filteredGroup.length === 0) {
        gTbody.innerHTML = `<tr><td colspan="8" class="py-8 text-center text-slate-400">Chưa có bài nộp nhóm nào phù hợp.</td></tr>`;
      } else {
        filteredGroup.forEach((item, idx) => {
          const row = document.createElement('tr');
          row.className = "hover:bg-slate-50 transition";
          row.innerHTML = `
            <td class="py-3 px-4 font-black text-amber-600">#${idx + 1}</td>
            <td class="py-3 px-4 font-extrabold text-slate-800">${item.groupName}</td>
            <td class="py-3 px-4 font-extrabold text-indigo-700">${item.className}</td>
            <td class="py-3 px-4 font-medium text-slate-600 text-xs">${item.lessonTitle}</td>
            <td class="py-3 px-4 text-xs font-medium text-slate-600">${item.members}</td>
            <td class="py-3 px-4 text-center font-mono font-black text-blue-600 text-base">${item.score10.toFixed(2)}</td>
            <td class="py-3 px-4 text-center font-medium text-slate-600">${item.timeStr || '--'}</td>
            <td class="py-3 px-4 text-right text-xs text-slate-400">${item.timestamp}</td>
          `;
          gTbody.appendChild(row);
        });
      }
    }

    function loadEditorLessonQuestions() {
      const editLId = parseInt(document.getElementById('editor-lesson-select').value);
      const qList = getLessonQuestionBank(editLId);
      const container = document.getElementById('editor-questions-list');
      container.innerHTML = '';

      qList.forEach((q, idx) => {
        const card = document.createElement('div');
        card.className = "bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-4";
        card.innerHTML = `
          <div class="flex items-center justify-between border-b border-slate-100 pb-2">
            <span class="px-2.5 py-1 rounded-lg bg-blue-700 text-white font-black text-xs">Câu ${idx + 1} [Dạng: ${q.type}]</span>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Nội dung câu hỏi:</label>
            <textarea id="edit-qtext-${q.id}" rows="2" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800">${q.question}</textarea>
          </div>
        `;
        container.appendChild(card);
      });
      triggerMathJax(container);
    }

    document.addEventListener('DOMContentLoaded', () => {
      const filterLesson = document.getElementById('filter-lesson');
      const editorLessonSelect = document.getElementById('editor-lesson-select');
      const oralLessonsContainer = document.getElementById('oral-lessons-checkbox-container');

      LESSON_METADATA.forEach(l => {
        const lbl = document.createElement('label');
        lbl.className = "flex items-center gap-2 p-2 rounded-xl bg-white border border-slate-200 hover:bg-blue-50 cursor-pointer text-xs font-bold text-slate-700 transition";
        lbl.innerHTML = `
          <input type="checkbox" name="oral-lesson-cb" value="${l.id}" checked class="w-4 h-4 text-blue-600 rounded">
          <span class="truncate">${l.title}</span>
        `;
        oralLessonsContainer.appendChild(lbl);
      });

      document.getElementById('btn-select-all-lessons').onclick = () => {
        document.querySelectorAll('input[name="oral-lesson-cb"]').forEach(cb => cb.checked = true);
      };
      document.getElementById('btn-deselect-all-lessons').onclick = () => {
        document.querySelectorAll('input[name="oral-lesson-cb"]').forEach(cb => cb.checked = false);
      };

      LESSON_METADATA.forEach(l => {
        const opt2 = document.createElement('option');
        opt2.value = l.id;
        opt2.textContent = l.title;
        filterLesson.appendChild(opt2);

        const opt3 = document.createElement('option');
        opt3.value = l.id;
        opt3.textContent = l.title;
        editorLessonSelect.appendChild(opt3);
      });

      const groupSelect = document.getElementById('group-select');
      for (let i = 1; i <= 12; i++) {
        const opt = document.createElement('option');
        opt.value = i;
        opt.textContent = `Nhóm số ${i}`;
        groupSelect.appendChild(opt);
      }

      document.getElementById('tab-btn-personal').onclick = () => {
        document.getElementById('tab-btn-personal').className = "flex-1 py-2.5 rounded-xl font-bold text-sm text-blue-700 bg-white shadow-sm transition flex items-center justify-center gap-2";
        document.getElementById('tab-btn-group').className = "flex-1 py-2.5 rounded-xl font-bold text-sm text-slate-500 hover:text-slate-800 transition flex items-center justify-center gap-2";
        document.getElementById('form-login-personal').classList.remove('hidden');
        document.getElementById('form-login-group').classList.add('hidden');
      };

      document.getElementById('tab-btn-group').onclick = () => {
        document.getElementById('tab-btn-group').className = "flex-1 py-2.5 rounded-xl font-bold text-sm text-blue-700 bg-white shadow-sm transition flex items-center justify-center gap-2";
        document.getElementById('tab-btn-personal').className = "flex-1 py-2.5 rounded-xl font-bold text-sm text-slate-500 hover:text-slate-800 transition flex items-center justify-center gap-2";
        document.getElementById('form-login-group').classList.remove('hidden');
        document.getElementById('form-login-personal').classList.add('hidden');
      };

      document.getElementById('form-login-personal').onsubmit = (e) => {
        e.preventDefault();
        const name = document.getElementById('student-name').value.trim();
        const pass = document.getElementById('student-pass').value.trim();
        const cls = document.getElementById('class-select').value;

        if (pass !== '123456') {
          showToast("Mật khẩu bài thi không đúng! (Mặc định: 123456)", "error");
          SoundFx.playWarning();
          return;
        }
        if (!name) {
          showToast("Vui lòng nhập họ và tên của bạn!", "warning");
          return;
        }

        activeUser = { type: 'personal', name, className: cls };
        showLessonSelectionView();
      };

      document.getElementById('form-login-group').onsubmit = (e) => {
        e.preventDefault();
        const groupNum = document.getElementById('group-select').value;
        const members = document.getElementById('group-members').value.trim();
        const cls = document.getElementById('group-class-select').value;

        if (!members) {
          showToast("Vui lòng nhập tên các thành viên trong nhóm!", "warning");
          return;
        }

        activeUser = { type: 'group', groupNum, members, className: cls, name: `Nhóm ${groupNum}` };
        showLessonSelectionView();
      };

      function showLessonSelectionView() {
        document.getElementById('view-login').classList.add('hidden');
        document.getElementById('student-welcome-title').textContent = `Xin chào, ${activeUser.name} [Lớp ${activeUser.className}]`;

        const container = document.getElementById('lesson-cards-container');
        container.innerHTML = '';

        LESSON_METADATA.forEach(l => {
          const card = document.createElement('div');
          card.className = "p-3.5 rounded-2xl border border-slate-200 bg-slate-50 hover:border-blue-400 hover:bg-blue-50/50 cursor-pointer transition flex items-center justify-between";
          card.innerHTML = `
            <div>
              <h4 class="font-bold text-sm text-slate-800">${l.title}</h4>
              <p class="text-xs text-slate-500">Ngân hàng ${l.totalQuestions} câu hỏi chuẩn SGK</p>
            </div>
            <input type="radio" name="selected-lesson-radio" value="${l.id}" class="w-4 h-4 text-blue-600 focus:ring-blue-500">
          `;
          card.onclick = () => card.querySelector('input').checked = true;
          container.appendChild(card);
        });

        document.getElementById('view-lesson-selection').classList.remove('hidden');
      }

      document.getElementById('btn-back-to-login').onclick = () => {
        document.getElementById('view-lesson-selection').classList.add('hidden');
        document.getElementById('view-login').classList.remove('hidden');
      };

      document.getElementById('btn-confirm-start-exam').onclick = () => {
        const checkedRadio = document.querySelector('input[name="selected-lesson-radio"]:checked');
        if (!checkedRadio) {
          showToast("Vui lòng chọn một bài kiểm tra!", "warning");
          return;
        }
        const val = checkedRadio.value;
        startExamSession(activeUser, val, false, null, []);
      };

      let targetAuthRole = null;
      const openRoleAuth = (role) => {
        targetAuthRole = role;
        document.getElementById('auth-password-input').value = '';
        document.getElementById('auth-modal').classList.remove('hidden');
      };

      document.getElementById('btn-teacher-login').onclick = () => openRoleAuth('teacher');
      document.getElementById('btn-parent-login').onclick = () => openRoleAuth('parent');
      document.getElementById('auth-cancel-btn').onclick = () => document.getElementById('auth-modal').classList.add('hidden');

      const submitAuth = () => {
        const pwd = document.getElementById('auth-password-input').value.trim();
        if (targetAuthRole === 'teacher' && pwd === '123') {
          document.getElementById('auth-modal').classList.add('hidden');
          activeUser = { type: 'teacher', name: 'Giáo Viên' };
          renderDashboard();
        } else if (targetAuthRole === 'parent' && pwd === '123456') {
          document.getElementById('auth-modal').classList.add('hidden');
          activeUser = { type: 'parent', name: 'Quý Phụ Huynh' };
          renderDashboard();
        } else {
          showToast("Mật khẩu không đúng!", "error");
        }
      };

      document.getElementById('auth-submit-btn').onclick = submitAuth;

      const oralModal = document.getElementById('oral-testing-modal');
      document.getElementById('btn-oral-testing-modal').onclick = () => oralModal.classList.remove('hidden');
      document.getElementById('close-oral-modal').onclick = () => oralModal.classList.add('hidden');

      document.getElementById('btn-spin-number').onclick = () => {
        let counter = 0;
        const displayEl = document.getElementById('random-number-display');
        SoundFx.playClick();
        const spinInterval = setInterval(() => {
          const randNum = Math.floor(Math.random() * 35) + 1;
          displayEl.textContent = randNum;
          counter++;
          if (counter > 15) {
            clearInterval(spinInterval);
            const finalNum = Math.floor(Math.random() * 35) + 1;
            displayEl.textContent = finalNum;
            document.getElementById('oral-stt-input').value = finalNum;
            document.getElementById('oral-student-name').value = `Học sinh STT ${finalNum}`;
            SoundFx.playSuccess();
          }
        }, 80);
      };

      document.getElementById('btn-start-oral-exam').onclick = () => {
        const stt = document.getElementById('oral-stt-input').value.trim();
        const name = document.getElementById('oral-student-name').value.trim();
        const cls = document.getElementById('oral-class-select').value;
        const chosenPackage = document.getElementById('oral-package-select').value;

        const checkedLessons = Array.from(document.querySelectorAll('input[name="oral-lesson-cb"]:checked')).map(cb => parseInt(cb.value));

        if (!name) {
          showToast("Vui lòng quay số hoặc nhập tên học sinh!", "warning");
          return;
        }
        if (checkedLessons.length === 0) {
          showToast("Vui lòng chọn ít nhất một bài học!", "warning");
          return;
        }

        oralModal.classList.add('hidden');
        const studentPayload = { type: 'personal', name: `${name} (STT ${stt || '?'})`, className: cls };
        startExamSession(studentPayload, checkedLessons[0], true, chosenPackage, checkedLessons);
      };

      document.getElementById('btn-portal-home').onclick = () => {
        if (timerInterval) clearInterval(timerInterval);
        if (questionTimerInterval) clearInterval(questionTimerInterval);
        document.getElementById('view-workspace').classList.add('hidden');
        document.getElementById('view-dashboard').classList.add('hidden');
        document.getElementById('view-lesson-selection').classList.add('hidden');
        document.getElementById('view-login').classList.remove('hidden');
      };

      document.getElementById('btn-submit-exam').onclick = () => submitExamProcess(false);
      document.getElementById('btn-retry-exam').onclick = () => startExamSession(activeUser, activeUser.lessonId, isPackageMode, packageType, []);
      document.getElementById('btn-choose-other-lesson').onclick = () => {
        document.getElementById('view-workspace').classList.add('hidden');
        showLessonSelectionView();
      };

      document.getElementById('dash-tab-personal').onclick = () => switchDashboardTab('personal');
      document.getElementById('dash-tab-group').onclick = () => switchDashboardTab('group');
      document.getElementById('dash-tab-editor').onclick = () => switchDashboardTab('editor');

      document.getElementById('filter-class').onchange = loadDashboardData;
      document.getElementById('filter-lesson').onchange = loadDashboardData;
      document.getElementById('filter-student-search').oninput = loadDashboardData;
    });
  </script>
</body>
</html>
