 <!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hệ Thống Thi Online Vật Lí 10 - Lớp Lí Thầy Trọng</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Nunito:wght@700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

  <script>
    window.MathJax = {
      tex: {
        inlineMath: [['$', '$'], ['\\(', '\\)']],
        displayMath: [['$$', '$$'], ['\\[', '\\]']],
        processEscapes: true
      },
      startup: {
        typeset: false,
        ready: () => {
          MathJax.startup.defaultReady();
          if (typeof window.triggerMathJax === 'function') {
            window.triggerMathJax();
          }
        }
      },
      svg: { fontCache: 'global' }
    };
  </script>
  <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f8fafc;
      color: #1e293b;
    }
    .font-heading {
      font-family: 'Nunito', sans-serif;
    }
    mjx-container {
      display: inline-block !important;
      margin: 0 2px !important;
      vertical-align: middle !important;
    }
    ::-webkit-scrollbar {
      width: 7px;
      height: 7px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    @keyframes subtle-pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.012); }
    }
    .animate-subtle {
      animation: subtle-pulse 2.5s infinite ease-in-out;
    }
    .math-live-preview {
      margin-top: 4px;
      font-size: 0.85rem;
      color: #0284c7;
      background-color: #f0f9ff;
      border: 1px dashed #bae6fd;
      border-radius: 0.5rem;
      padding: 4px 8px;
      min-height: 28px;
      line-height: 1.4;
      word-break: break-word;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-blue-600 selection:text-white">

  <!-- Thông báo Toast -->
  <div id="toast-container" class="fixed top-5 right-5 z-[9999] flex flex-col gap-2 pointer-events-none"></div>

  <!-- Modal xác nhận chung -->
  <div id="custom-modal" class="fixed inset-0 z-[9998] hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 transform transition-all scale-95 opacity-0" id="custom-modal-box">
      <div class="flex items-center gap-3 mb-4">
        <div id="custom-modal-icon" class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center text-xl shrink-0">
          <i class="fa-solid fa-circle-question"></i>
        </div>
        <div>
          <h3 id="custom-modal-title" class="text-lg font-extrabold text-slate-800">Xác nhận</h3>
          <p id="custom-modal-subtitle" class="text-xs text-slate-500">Thông báo từ hệ thống bài thi</p>
        </div>
      </div>
      <div id="custom-modal-content" class="text-sm text-slate-600 mb-6 leading-relaxed"></div>
      <div id="custom-modal-actions" class="flex justify-end gap-3">
        <button id="custom-modal-btn-cancel" class="px-4 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100 rounded-xl transition">Hủy</button>
        <button id="custom-modal-btn-confirm" class="px-5 py-2.5 text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-md transition">Đồng ý</button>
      </div>
    </div>
  </div>

  <!-- Modal Đăng nhập Quản trị (Giáo viên / Phụ huynh) -->
  <div id="auth-modal" class="fixed inset-0 z-[9990] hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl border border-slate-100">
      <div class="text-center mb-5">
        <div id="auth-modal-badge" class="w-16 h-16 mx-auto mb-3 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-3xl shadow-inner">
          <i class="fa-solid fa-lock"></i>
        </div>
        <h3 id="auth-modal-title" class="text-xl font-extrabold text-slate-800">Xác thực quyền hạn</h3>
        <p id="auth-modal-desc" class="text-xs text-slate-500 mt-1">Vui lòng nhập mật khẩu quản trị</p>
      </div>
      <div class="mb-4">
        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Mật khẩu</label>
        <div class="relative">
          <input type="password" id="auth-password-input" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-center text-lg font-bold tracking-widest focus:ring-2 focus:ring-blue-500 outline-none transition" placeholder="••••••">
          <button type="button" id="toggle-auth-pwd" class="absolute right-3 top-3.5 text-slate-400 hover:text-slate-600">
            <i class="fa-regular fa-eye"></i>
          </button>
        </div>
      </div>
      <div class="flex gap-2">
        <button id="auth-cancel-btn" class="w-1/2 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold text-sm hover:bg-slate-50 transition">Đóng</button>
        <button id="auth-submit-btn" class="w-1/2 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-md transition">Đăng nhập</button>
      </div>
    </div>
  </div>

  <!-- Header chung -->
  <header class="bg-gradient-to-r from-blue-900 via-indigo-900 to-sky-900 text-white shadow-lg sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-white/10 backdrop-blur-md flex items-center justify-center text-xl border border-white/20 shadow-inner">
          <i class="fa-solid fa-atom text-cyan-300"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs uppercase tracking-wider font-extrabold px-2 py-0.5 rounded-md bg-white text-blue-900 shadow-sm">VẬT LÍ 10</span>
            <span class="text-xs text-blue-200 font-medium">Hệ Thống Thi Online 12 Bài</span>
          </div>
          <h1 class="text-base sm:text-lg font-black font-heading tracking-tight leading-none text-white mt-0.5" id="header-main-title">
            CỔNG THI VẬT LÍ 10 <span class="text-xs font-normal text-blue-200">| Lớp Lí Thầy Trọng</span>
          </h1>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button id="btn-portal-home" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-white/10 hover:bg-white/20 text-white border border-white/20 transition flex items-center gap-1.5">
          <i class="fa-solid fa-house"></i>
          <span>Trang chủ</span>
        </button>
        <button id="btn-parent-login" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-white/10 hover:bg-white/20 text-white border border-white/20 transition flex items-center gap-1.5 shadow-sm">
          <i class="fa-solid fa-hands-holding-child text-amber-300"></i>
          <span>Phụ huynh</span>
        </button>
        <button id="btn-teacher-login" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-400 hover:bg-amber-300 text-slate-900 transition flex items-center gap-1.5 shadow-md">
          <i class="fa-solid fa-chalkboard-user"></i>
          <span>Giáo viên</span>
        </button>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 flex flex-col">

    <!-- VIEW 1: CỔNG ĐĂNG NHẬP BAN ĐẦU (CHƯA HIỆN BÀI THI) -->
    <div id="view-login" class="w-full max-w-2xl mx-auto my-auto py-6">
      <div class="bg-white rounded-3xl shadow-xl border border-slate-100 p-6 sm:p-8 relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-blue-100 rounded-full blur-2xl opacity-60"></div>
        <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-sky-100 rounded-full blur-2xl opacity-60"></div>

        <div class="relative z-10 text-center mb-6">
          <div class="inline-flex flex-wrap items-center justify-center gap-2 mb-2">
            <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-black uppercase">
              <i class="fa-solid fa-graduation-cap mr-1"></i>LỚP LÍ THẦY TRỌNG
            </span>
            <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-black uppercase">
              THANG ĐIỂM CHUẨN 10.0
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black font-heading text-slate-800">Cổng Thi Trực Tuyến Lớp 10</h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">Đăng nhập tài khoản học sinh để vào danh sách bài kiểm tra</p>
        </div>

        <!-- Tab chuyển đổi hình thức: Cá nhân / Nhóm -->
        <div class="relative z-10 flex p-1 bg-slate-100 rounded-2xl mb-6">
          <button id="tab-btn-personal" class="flex-1 py-2.5 rounded-xl font-bold text-sm text-blue-700 bg-white shadow-sm transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-user"></i>
            <span>Thi Cá Nhân</span>
          </button>
          <button id="tab-btn-group" class="flex-1 py-2.5 rounded-xl font-bold text-sm text-slate-500 hover:text-slate-800 transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-users"></i>
            <span>Thi Theo Nhóm</span>
          </button>
        </div>

        <!-- Form đăng nhập cá nhân -->
        <form id="form-login-personal" class="relative z-10 space-y-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Chọn Lớp Học</label>
            <select id="class-select" class="w-full px-3.5 py-3 bg-slate-50 border border-slate-300 rounded-xl font-bold text-slate-800 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition text-sm mb-3">
              <option value="10A">Lớp 10A</option>
              <option value="10B">Lớp 10B</option>
              <option value="10C">Lớp 10C</option>
              <option value="10 Toán">Lớp 10 Toán</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Họ và Tên Học Sinh</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400"><i class="fa-regular fa-id-card"></i></span>
              <input type="text" id="student-name" required placeholder="Ví dụ: Nguyễn Hoàng Nam" class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl font-semibold text-slate-800 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition text-sm">
            </div>
          </div>
          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">Mật khẩu bài thi</label>
              <span class="text-[11px] text-blue-600 font-medium">(Mặc định: 123456)</span>
            </div>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400"><i class="fa-solid fa-key"></i></span>
              <input type="password" id="student-pass" required value="123456" class="w-full pl-10 pr-10 py-3 bg-slate-50 border border-slate-200 rounded-xl font-semibold text-slate-800 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition text-sm">
              <button type="button" class="toggle-pwd-btn absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600">
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>
          <button type="submit" id="btn-start-personal" class="w-full py-3.5 bg-gradient-to-r from-blue-600 via-indigo-600 to-sky-600 hover:from-blue-700 hover:to-sky-700 text-white font-extrabold rounded-2xl shadow-lg transition flex items-center justify-center gap-2 text-base">
            <span>Tiếp Tục Chọn Bài Thi</span>
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </form>

        <!-- Form thi nhóm -->
        <form id="form-login-group" class="relative z-10 space-y-4 hidden">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Chọn Lớp Học</label>
            <select id="group-class-select" class="w-full px-3.5 py-3 bg-slate-50 border border-slate-300 rounded-xl font-bold text-slate-800 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition text-sm mb-3">
              <option value="10A">Lớp 10A</option>
              <option value="10B">Lớp 10B</option>
              <option value="10C">Lớp 10C</option>
              <option value="10 Toán">Lớp 10 Toán</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Số Hiệu Nhóm</label>
            <select id="group-select" class="w-full pl-3.5 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-800 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition text-sm">
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Danh Sách Thành Viên (2 - 4 bạn)</label>
            <textarea id="group-members" rows="2" required placeholder="Nhập tên các bạn (VD: An, Bình, Châu, Dũng)" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl font-medium text-slate-800 focus:bg-white focus:ring-2 focus:ring-blue-500 outline-none transition text-sm"></textarea>
          </div>
          <button type="submit" id="btn-start-group" class="w-full py-3.5 bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white font-extrabold rounded-2xl shadow-lg transition flex items-center justify-center gap-2 text-base">
            <span>Nhóm Chọn Bài Thi</span>
            <i class="fa-solid fa-play"></i>
          </button>
        </form>
      </div>
    </div>

    <!-- VIEW 1.5: CHỌN BÀI THI SAU KHI ĐĂNG NHẬP -->
    <div id="view-lesson-selection" class="w-full max-w-3xl mx-auto my-auto py-6 hidden">
      <div class="bg-white rounded-3xl shadow-xl border border-slate-100 p-6 sm:p-8 relative">
        <div class="flex items-center justify-between mb-6 border-b border-slate-100 pb-4">
          <div>
            <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-black uppercase">
              <i class="fa-solid fa-user-check mr-1"></i>Đã Đăng Nhập
            </span>
            <h2 id="student-welcome-title" class="text-xl sm:text-2xl font-black font-heading text-slate-800 mt-1">Xin chào, Học sinh</h2>
          </div>
          <button id="btn-back-to-login" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-xs font-bold transition">
            <i class="fa-solid fa-arrow-left mr-1"></i>Đổi tài khoản
          </button>
        </div>

        <div class="space-y-6">
          <div>
            <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">
              <i class="fa-solid fa-book-open text-blue-600 mr-1"></i>Chọn Bài Kiểm Tra (Từ Bài 1 đến Bài 12)
            </label>
            <div id="lesson-cards-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-96 overflow-y-auto pr-2">
              <!-- Render danh sách bài kiểm tra -->
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-blue-50 border border-blue-200 flex items-center justify-between gap-4">
            <div>
              <h4 class="font-bold text-sm text-blue-900">Sẵn sàng làm bài?</h4>
              <p class="text-xs text-blue-700">Thời gian làm bài quy chuẩn theo chuẩn 20 phút cho toàn bộ đề.</p>
            </div>
            <button id="btn-confirm-start-exam" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-extrabold text-sm shadow-md transition shrink-0">
              Vào Phòng Thi Ngay
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- VIEW 2: KHÔNG GIAN LÀM BÀI THI -->
    <div id="view-workspace" class="w-full hidden space-y-6">

      <!-- Lời chào banner -->
      <div id="welcome-banner" class="bg-gradient-to-r from-blue-800 via-indigo-800 to-sky-800 rounded-2xl p-4 text-white shadow-lg flex flex-wrap items-center justify-between gap-3 animate-subtle">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur-md flex items-center justify-center text-2xl" id="workspace-icon">
            ⚛️
          </div>
          <div>
            <h3 id="welcome-user-heading" class="font-extrabold text-base sm:text-lg">Chào mừng bạn đến với bài thi!</h3>
            <p class="text-xs text-white/90" id="welcome-user-sub">"Chúc các em học sinh làm bài thật tốt và đạt điểm 10 tuyệt đối nhé!"</p>
          </div>
        </div>
        <button id="btn-replay-greeting" class="px-3.5 py-2 bg-white text-blue-900 hover:bg-blue-50 rounded-xl font-bold text-xs shadow-md transition flex items-center gap-1.5 shrink-0">
          <i class="fa-solid fa-volume-high"></i>
          <span>Nghe lời chúc</span>
        </button>
      </div>

      <!-- Sticky Nav Bar -->
      <div id="sticky-exam-nav" class="sticky top-[61px] z-30 bg-white/95 backdrop-blur-md rounded-2xl p-3 sm:p-4 shadow-md border border-slate-200 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4 w-full md:w-auto justify-between md:justify-start">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-blue-500 animate-ping"></span>
            <div class="text-xs">
              <span class="font-bold text-slate-700 block leading-tight" id="participant-display-name">Thí sinh: Đang thi</span>
              <span class="text-slate-500 text-[11px]" id="answered-count-indicator">Tiến độ: 0/0</span>
            </div>
          </div>

          <div class="flex items-center gap-2 bg-rose-50 border border-rose-200 px-3 py-1.5 rounded-xl">
            <i class="fa-solid fa-stopwatch text-rose-600 animate-pulse"></i>
            <span id="exam-timer" class="font-mono font-black text-rose-600 text-base sm:text-lg">20:00</span>
          </div>
        </div>

        <div class="w-full md:max-w-2xl overflow-x-auto pb-1 md:pb-0">
          <div class="flex items-center gap-1.5 justify-start md:justify-center min-w-max" id="nav-question-pill-container"></div>
        </div>

        <div class="flex items-center gap-2 w-full md:w-auto justify-end">
          <button id="btn-submit-exam" class="hidden px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold text-xs shadow-md transition flex items-center justify-center gap-1.5">
            <i class="fa-solid fa-paper-plane"></i>
            <span>Nộp Bài</span>
          </button>
          <button id="btn-logout-student" class="px-3 py-2 bg-slate-100 hover:bg-rose-50 text-slate-600 hover:text-rose-600 rounded-xl font-bold text-xs border border-slate-200 transition flex items-center justify-center gap-1">
            <i class="fa-solid fa-door-open"></i>
            <span>Thoát</span>
          </button>
        </div>
      </div>

      <!-- Thẻ kết quả bài thi sau khi nộp -->
      <div id="result-summary-card" class="hidden bg-white rounded-3xl p-6 sm:p-8 shadow-xl border border-slate-100 text-center">
        <div id="result-icon-badge" class="w-20 h-20 mx-auto rounded-3xl flex items-center justify-center text-4xl mb-4 shadow-inner">
          🏆
        </div>
        <h2 id="result-title" class="text-2xl sm:text-3xl font-black font-heading text-slate-800">Kết Quả Bài Kiểm Tra</h2>
        <p class="text-xs font-bold text-slate-400 mt-1 uppercase" id="result-lesson-title">Bài thi môn Vật lí 10</p>
        <div class="flex items-center justify-center gap-3 my-4">
          <span class="text-xs uppercase font-bold text-slate-400">Điểm số quy chuẩn:</span>
          <span id="result-final-score" class="text-4xl sm:text-5xl font-black text-blue-600 font-heading">0.0</span>
          <span class="text-2xl font-black text-slate-400 font-heading">/ 10.0 điểm</span>
        </div>
        <p id="result-raw-info" class="text-xs text-slate-400 mb-2">Điểm thô: 0/10</p>
        <p id="result-feedback-msg" class="text-sm font-semibold text-slate-600 max-w-lg mx-auto mb-6"></p>
        <div class="flex flex-wrap items-center justify-center gap-3">
