    function parseFlexibleNumber(raw) {
      if (raw === undefined || raw === null) return NaN;
      let str = String(raw).trim().replace(/[^\d.,-]/g, '');
      if (!str) return NaN;
      return parseFloat(str.replace(',', '.'));
    }

    function submitExamProcess(isAuto = false) {
      if (isExamSubmitted) return;
      if (!isAuto && !isPackageMode) {
        showCustomModal({
          title: "Xác Nhận Nộp Bài Thi",
          content: "Bạn có chắc chắn muốn nộp bài ngay bây giờ?",
          confirmText: "Nộp bài",
          cancelText: "Hủy",
          onConfirm: () => gradeAndShowResults()
        });
      } else {
        gradeAndShowResults();
      }
    }

    function gradeAndShowResults() {
      if (timerInterval) clearInterval(timerInterval);
      if (questionTimerInterval) clearInterval(questionTimerInterval);
      isExamSubmitted = true;

      let rawScore = 0;
      let totalRaw = currentExamQuestions.length;

      currentExamQuestions.forEach((q) => {
        let qScore = 0;
        const ans = studentAnswers[q.id];

        if (isPackageMode) {
          const maxQScore = q.packageScore || 2.0;
          if (q.type === 'MC') {
            if (ans !== undefined && parseInt(ans) === q.correct) qScore = maxQScore;
          } else if (q.type === 'TF_CLUSTER') {
            let correctCount = 0;
            if (ans && typeof ans === 'object') {
              q.statements.forEach((stmt, sIdx) => { if (ans[sIdx] === stmt.answer) correctCount++; });
            }
            qScore = (correctCount / 4) * maxQScore;
          } else if (q.type === 'SHORT_ANS') {
            if (ans && typeof ans === 'string') {
              const parsed = parseFlexibleNumber(ans);
              const target = q.correctNumber;
              if (!isNaN(parsed) && Math.abs(parsed - target) <= Math.max(0.01, Math.abs(target * 0.02))) qScore = maxQScore;
            }
          } else if (q.type === 'MATCH') {
            let matchCount = 0;
            if (ans && typeof ans === 'object') {
              Object.keys(q.pairs).forEach(k => { if (ans[k] === q.pairs[k]) matchCount++; });
            }
            qScore = (matchCount / 4) * maxQScore;
          } else if (q.type === 'FILL_BLANK') {
            qScore = maxQScore;
          }
          rawScore += qScore;
        } else {
          if (q.type === 'MC') {
            if (ans !== undefined && parseInt(ans) === q.correct) qScore = 1.0;
          } else if (q.type === 'TF_CLUSTER') {
            let correctCount = 0;
            if (ans && typeof ans === 'object') {
              q.statements.forEach((stmt, sIdx) => { if (ans[sIdx] === stmt.answer) correctCount++; });
            }
            if (correctCount === 4) qScore = 1.0;
            else if (correctCount >= 2) qScore = 0.5;
            else if (correctCount === 1) qScore = 0.2;
          } else if (q.type === 'SHORT_ANS') {
            if (ans && typeof ans === 'string') {
              const parsed = parseFlexibleNumber(ans);
              if (!isNaN(parsed) && Math.abs(parsed - q.correctNumber) <= 0.1) qScore = 1.0;
            }
          } else if (q.type === 'MATCH') {
            let matchCount = 0;
            if (ans && typeof ans === 'object') {
              Object.keys(q.pairs).forEach(k => { if (ans[k] === q.pairs[k]) matchCount++; });
            }
            qScore = (matchCount / 4) * 1.0;
          } else if (q.type === 'FILL_BLANK') {
            qScore = 1.0;
          }
          rawScore += qScore;
        }
      });

      const finalScore10 = isPackageMode ? Math.round(rawScore * 100) / 100 : Math.round(((rawScore / totalRaw) * 10) * 100) / 100;
      const spentTimeSec = totalExamTime - Math.max(0, timeRemaining);
      const spentMin = Math.floor(spentTimeSec / 60);
      const spentSec = spentTimeSec % 60;
      const timeStr = `${spentMin}m ${spentSec}s`;

      saveSubmissionRecord(finalScore10, rawScore, totalRaw, spentTimeSec, timeStr);

      const summaryCard = document.getElementById('result-summary-card');
      summaryCard.classList.remove('hidden');
      document.getElementById('result-lesson-title').textContent = `${activeUser.lessonTitle} - Lớp ${activeUser.className}`;
      document.getElementById('result-final-score').textContent = finalScore10.toFixed(2);
      document.getElementById('result-raw-info').textContent = `Tổng điểm đạt được: ${rawScore.toFixed(2)} điểm | Thời gian: ${timeStr}`;

      const feedbackMsg = document.getElementById('result-feedback-msg');
      if (finalScore10 >= 8.0) {
        feedbackMsg.innerHTML = `<span class="text-blue-600 font-bold text-base block mb-1">🎉 Xuất sắc!</span> Bạn hoàn thành rất tốt gói câu hỏi.`;
        SoundFx.playApplause();
        confetti({ particleCount: 150, spread: 100, origin: { y: 0.4 } });
      } else {
        feedbackMsg.innerHTML = `<span class="text-amber-600 font-bold text-base block mb-1">Cố gắng hơn nhé!</span> Hãy tiếp tục luyện tập thêm.`;
        SoundFx.playSuccess();
      }

      summaryCard.scrollIntoView({ behavior: 'smooth' });
    }

    function saveSubmissionRecord(score10, rawScore, totalRaw, spentTimeSec, timeStr) {
      if (!activeUser) return;
      const now = new Date();
      const timeStamp = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')} - ${now.getDate()}/${now.getMonth() + 1}`;

      if (activeUser.type === 'personal') {
        let personalList = [];
        try { personalList = JSON.parse(localStorage.getItem(RESULTS_PERSONAL_KEY)) || []; } catch (e) {}

        const cleanName = activeUser.name.trim().toLowerCase();
        const existingIdx = personalList.findIndex(
          item => item.name.trim().toLowerCase() === cleanName && 
                  item.className === activeUser.className &&
                  item.lessonId === activeUser.lessonId
        );

        const newRecord = {
          name: activeUser.name.trim(),
          className: activeUser.className,
          lessonId: activeUser.lessonId,
          lessonTitle: activeUser.lessonTitle,
          score10: score10,
          spentTimeSec: spentTimeSec,
          timeStr: timeStr,
          timestamp: timeStamp
        };

        if (existingIdx !== -1) personalList[existingIdx] = newRecord;
        else personalList.push(newRecord);

        localStorage.setItem(RESULTS_PERSONAL_KEY, JSON.stringify(personalList));
      } else if (activeUser.type === 'group') {
        let groupList = [];
        try { groupList = JSON.parse(localStorage.getItem(RESULTS_GROUP_KEY)) || []; } catch (e) {}

        const groupNumKey = `Nhóm ${activeUser.groupNum}`;
        const existingIdx = groupList.findIndex(
          item => item.groupName === groupNumKey && 
                  item.className === activeUser.className &&
                  item.lessonId === activeUser.lessonId
        );

        const newRecord = {
          groupName: groupNumKey,
          className: activeUser.className,
          lessonId: activeUser.lessonId,
          lessonTitle: activeUser.lessonTitle,
          members: activeUser.members,
          score10: score10,
          spentTimeSec: spentTimeSec,
          timeStr: timeStr,
          timestamp: timeStamp
        };

        if (existingIdx !== -1) groupList[existingIdx] = newRecord;
        else groupList.push(newRecord);

        localStorage.setItem(RESULTS_GROUP_KEY, JSON.stringify(groupList));
      }
    }
  </script>

