    function checkIsQuestionAnswered(qid) {
      const ans = studentAnswers[qid];
      if (ans === undefined || ans === null) return false;
      const q = currentExamQuestions.find(i => i.id === qid);
      if (!q) return false;
      if (q.type === 'MC') return ans !== undefined;
      if (q.type === 'TF_CLUSTER' || q.type === 'MATCH' || q.type === 'FILL_BLANK') {
        return typeof ans === 'object' && Object.keys(ans).length > 0;
      }
      if (q.type === 'SHORT_ANS') return typeof ans === 'string' && ans.trim().length > 0;
      return false;
    }

