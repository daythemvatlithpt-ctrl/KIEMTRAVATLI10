          question: `[${lesson.code}] Ghép cặp khái niệm/đại lượng ở Cột 1 với ý nghĩa/công thức tương ứng ở Cột 2:`,
          col1: [
            { id: '1', text: `1. Đại lượng đặc trưng trong ${k.name}` },
            { id: '2', text: `2. Công thức cơ bản của bài` },
            { id: '3', text: `3. Thiết bị đo kiểm chuẩn` },
            { id: '4', text: `4. Đơn vị đo trong hệ SI` }
          ],
          col2: [
            { id: 'A', text: `A. Phản ánh bản chất vật lí chính xác` },
            { id: 'B', text: `B. Thể hiện qua hệ thức: $${k.formula}$` },
            { id: 'C', text: `C. Dụng cụ thực hành tại phòng thí nghiệm` },
            { id: 'D', text: `D. Đơn vị chuẩn quy ước quốc tế` }
          ],
          pairs: { '1': 'A', '2': 'B', '3': 'C', '4': 'D' },
          explanation: `Ghép nối đúng chuẩn SGK: 1-A, 2-B, 3-C, 4-D.`
        });
      }

      while (idCounter <= totalQ) {
        qList.push({
          id: idCounter++,
          type: 'FILL_BLANK',
          question: `[${lesson.code}] Hoàn thiện nhận định sau: "Trong nghiên cứu ${k.name}, đại lượng [1] có vai trò then chốt; công thức liên hệ cơ bản là [2]."`,
          textTemplate: `Trong nghiên cứu ${k.name}, đại lượng [1] có vai trò then chốt; công thức liên hệ cơ bản là [2].`,
          blanks: { '1': "vật lí", '2': `$${k.formula}$` },
          wordPool: ["vật lí", `$${k.formula}$`, "hóa học", "sinh học", "tùy ý", "bằng 0"],
          explanation: `Điền đúng ô [1] là "vật lí" và ô [2] là "$${k.formula}$".`
        });
      }

      return qList;
    }
  </script>

  <!-- HỆ THỐNG QUẢN LÝ DỮ LIỆU & STORAGE TRUNG TÂM -->
  <script>
    const STORAGE_KEY_PREFIX = 'vatli10_portal_v2026_';
    const RESULTS_PERSONAL_KEY = 'vatli10_portal_personal_records_v2026';
    const RESULTS_GROUP_KEY = 'vatli10_portal_group_records_v2026';

    let selectedLessonId = 1;
    let selectedClass = '10A';
    let currentQuestions = [];
    let currentExamQuestions = [];
    let studentAnswers = {};
    let activeUser = null;
    let timerInterval = null;
    let timeRemaining = 1200;
    let totalExamTime = 1200;
    let isExamSubmitted = false;

    let isPackageMode = false;
    let packageType = null;
    let currentQuestionIndex = 0;
    let questionTimerInterval = null;
    let questionTimeRemaining = 20;

    function getLessonQuestionBank(lessonId) {
      const storageKey = `${STORAGE_KEY_PREFIX}lesson_${lessonId}`;
      try {
        const raw = localStorage.getItem(storageKey);
        if (raw) return JSON.parse(raw);
      } catch (e) {}
      const def = generateLessonBank(lessonId);
      localStorage.setItem(storageKey, JSON.stringify(def));
      return def;
    }

    function saveLessonQuestionBank(lessonId, questions) {
      const storageKey = `${STORAGE_KEY_PREFIX}lesson_${lessonId}`;
      localStorage.setItem(storageKey, JSON.stringify(questions));
    }

    const SoundFx = {
      async playApplause() {
        try {
          await Tone.start();
          const synth = new Tone.PolySynth(Tone.Synth, {
            oscillator: { type: "triangle" },
            envelope: { attack: 0.05, decay: 0.1, sustain: 0.3, release: 0.5 }
          }).toDestination();
          const now = Tone.now();
          synth.triggerAttackRelease(["C5", "E5", "G5"], "8n", now);
          synth.triggerAttackRelease(["E5", "G5", "C6"], "8n", now + 0.2);
          synth.triggerAttackRelease(["G5", "B5", "D6"], "8n", now + 0.4);
          synth.triggerAttackRelease(["C6", "E6", "G6"], "4n", now + 0.6);
        } catch (e) {}
      },
      async playSuccess() {
        try {
          await Tone.start();
          const synth = new Tone.Synth().toDestination();
          const now = Tone.now();
          synth.triggerAttackRelease("C5", "16n", now);
          synth.triggerAttackRelease("G5", "16n", now + 0.12);
          synth.triggerAttackRelease("C6", "8n", now + 0.24);
        } catch (e) {}
      },
      async playWarning() {
        try {
          await Tone.start();
          const synth = new Tone.Synth({ oscillator: { type: "sawtooth" } }).toDestination();
          const now = Tone.now();
          synth.triggerAttackRelease("F3", "8n", now);
          synth.triggerAttackRelease("Db3", "4n", now + 0.2);
        } catch (e) {}
      },
      async playClick() {
        try {
          await Tone.start();
          const synth = new Tone.MembraneSynth().toDestination();
          synth.triggerAttackRelease("C2", "32n");
        } catch (e) {}
      }
    };

    function speakGreeting(textToSpeak) {
      if (!('speechSynthesis' in window)) return;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(textToSpeak);
      utterance.lang = 'vi-VN';
      utterance.rate = 0.95;
      utterance.pitch = 1.05;
      window.speechSynthesis.speak(utterance);
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colors = {
        success: 'bg-emerald-600 text-white border-emerald-700',
        error: 'bg-rose-600 text-white border-rose-700',
        warning: 'bg-amber-500 text-white border-amber-600',
        info: 'bg-blue-600 text-white border-blue-700'
      };
      const icons = {
        success: 'fa-check-circle',
        error: 'fa-triangle-exclamation',
        warning: 'fa-bell',
        info: 'fa-circle-info'
      };

      toast.className = `px-4 py-3 rounded-2xl shadow-xl border flex items-center gap-3 text-sm font-semibold pointer-events-auto transform transition-all duration-300 translate-y-2 opacity-0 ${colors[type] || colors.info}`;
      toast.innerHTML = `<i class="fa-solid ${icons[type]} text-base"></i><span>${message}</span>`;
      container.appendChild(toast);

      requestAnimationFrame(() => toast.classList.remove('translate-y-2', 'opacity-0'));
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-x-full');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    function showCustomModal({ title, subtitle = "Thông báo hệ thống", content, confirmText = "Đồng ý", cancelText = "Hủy", onConfirm, onCancel }) {
      const modal = document.getElementById('custom-modal');
      const box = document.getElementById('custom-modal-box');
      document.getElementById('custom-modal-title').textContent = title;
      document.getElementById('custom-modal-subtitle').textContent = subtitle;
      document.getElementById('custom-modal-content').innerHTML = content;
      const btnConfirm = document.getElementById('custom-modal-btn-confirm');
      const btnCancel = document.getElementById('custom-modal-btn-cancel');

      btnConfirm.textContent = confirmText;
      btnCancel.textContent = cancelText;

      modal.classList.remove('hidden');
      requestAnimationFrame(() => {
        box.classList.remove('scale-95', 'opacity-0');
        box.classList.add('scale-100', 'opacity-100');
      });

      const cleanup = () => {
        box.classList.remove('scale-100', 'opacity-100');
        box.classList.add('scale-95', 'opacity-0');
        setTimeout(() => modal.classList.add('hidden'), 200);
      };

      btnConfirm.onclick = () => { cleanup(); if (typeof onConfirm === 'function') onConfirm(); };
      btnCancel.onclick = () => { cleanup(); if (typeof onCancel === 'function') onCancel(); };
    }

    function triggerMathJax(targetEl = null) {
      if (!window.MathJax || !window.MathJax.typesetPromise) return;
      try {
        const elements = targetEl ? (Array.isArray(targetEl) ? targetEl : [targetEl]) : undefined;
        if (window.MathJax.typesetClear) window.MathJax.typesetClear(elements);
        window.MathJax.typesetPromise(elements).catch(e => console.debug(e));
      } catch (e) {}
    }
  </script>

  <!-- VẬN HÀNH BÀI THI & CHẤM ĐIỂM CHUẨN 10.0 -->
  <script>
    function generatePackageQuestionsFromLessons(type, lessonIdsArr) {
      let poolMC = [];
      let poolTF = [];
      let poolShort = [];
      let poolMatch = [];
      let poolFill = [];

      lessonIdsArr.forEach(lId => {
        const bank = getLessonQuestionBank(lId);
        poolMC.push(...bank.filter(q => q.type === 'MC'));
        poolTF.push(...bank.filter(q => q.type === 'TF_CLUSTER'));
        poolShort.push(...bank.filter(q => q.type === 'SHORT_ANS'));
        poolMatch.push(...bank.filter(q => q.type === 'MATCH'));
        poolFill.push(...bank.filter(q => q.type === 'FILL_BLANK'));
      });

      const shuffleSub = (arr) => {
        let a = [...arr];
        for (let i = a.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
      };

      let selected = [];
      if (type === '2') {
        const m = shuffleSub(poolMatch)[0] || { id: 999, type: 'MATCH', question: "Ghép nối cơ bản", col1: [{id:'1', text:'A'}], col2: [{id:'A', text:'1'}], pairs:{'1':'A'}, explanation:"" };
        const tf = shuffleSub(poolTF)[0] || { id: 998, type: 'TF_CLUSTER', question: "Đúng sai cơ bản", statements: [{text:'a)', answer:true}], explanation:"" };
        selected = [JSON.parse(JSON.stringify(m)), JSON.parse(JSON.stringify(tf))];
        selected.forEach(s => s.packageScore = 5.0);
      } else if (type === '4') {
        const mc = shuffleSub(poolMC)[0] || { id: 997, type: 'MC', question: "Trắc nghiệm cơ bản", options: ["Đúng", "Sai", "Khác", "Tất cả"], correct: 0, explanation:"" };
        const sh = shuffleSub(poolShort)[0] || { id: 996, type: 'SHORT_ANS', question: "Trả lời ngắn cơ bản", correctNumber: 1, explanation:"" };
        const m = shuffleSub(poolMatch)[0] || { id: 995, type: 'MATCH', question: "Ghép nối cơ bản", col1: [{id:'1', text:'A'}], col2: [{id:'A', text:'1'}], pairs:{'1':'A'}, explanation:"" };
        const tf = shuffleSub(poolTF)[0] || { id: 994, type: 'TF_CLUSTER', question: "Đúng sai cơ bản", statements: [{text:'a)', answer:true}], explanation:"" };
        selected = [
          JSON.parse(JSON.stringify(mc)),
          JSON.parse(JSON.stringify(sh)),
          JSON.parse(JSON.stringify(m)),
          JSON.parse(JSON.stringify(tf))
        ];
        selected.forEach(s => s.packageScore = 2.5);
      } else if (type === '5') {
        const mc = shuffleSub(poolMC)[0] || { id: 993, type: 'MC', question: "Trắc nghiệm cơ bản", options: ["Đúng", "Sai", "Khác", "Tất cả"], correct: 0, explanation:"" };
        const sh = shuffleSub(poolShort)[0] || { id: 992, type: 'SHORT_ANS', question: "Trả lời ngắn cơ bản", correctNumber: 1, explanation:"" };
        const fi = shuffleSub(poolFill)[0] || { id: 991, type: 'FILL_BLANK', question: "Điền khuyết", textTemplate: "Đại lượng [1] có giá trị [2].", blanks:{'1':'a','2':'b'}, wordPool:['a','b','c'], explanation:"" };
        const m = shuffleSub(poolMatch)[0] || { id: 990, type: 'MATCH', question: "Ghép nối cơ bản", col1: [{id:'1', text:'A'}], col2: [{id:'A', text:'1'}], pairs:{'1':'A'}, explanation:"" };
        const tf = shuffleSub(poolTF)[0] || { id: 989, type: 'TF_CLUSTER', question: "Đúng sai cơ bản", statements: [{text:'a)', answer:true}], explanation:"" };
        selected = [
          JSON.parse(JSON.stringify(mc)),
          JSON.parse(JSON.stringify(sh)),
          JSON.parse(JSON.stringify(fi)),
          JSON.parse(JSON.stringify(m)),
          JSON.parse(JSON.stringify(tf))
        ];
        selected.forEach(s => s.packageScore = 2.0);
      }

      selected.forEach(q => {
        if (q.type === 'MC' && Array.isArray(q.options)) {
          const originalCorrect = q.options[q.correct];
          for (let i = q.options.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [q.options[i], q.options[j]] = [q.options[j], q.options[i]];
          }
          q.correct = q.options.indexOf(originalCorrect);
        }
      });

      return selected;
    }

    function startExamSession(userPayload, chosenLessonVal, isPack = false, packT = null, lessonIdsArray = []) {
      activeUser = userPayload;
      isPackageMode = isPack;
      packageType = packT;
      let lessonTitle = "";

      if (isPackageMode) {
        if (packageType === '2') lessonTitle = `Dò Bài Cũ - Gói 2 Câu (20s/câu)`;
        else if (packageType === '4') lessonTitle = `Dò Bài Cũ - Gói 4 Câu (20s/câu)`;
        else if (packageType === '5') lessonTitle = `Dò Bài Cũ - Gói 5 Câu (20s/câu)`;

        activeUser.lessonId = `oral_pack${packageType}`;
        activeUser.lessonTitle = lessonTitle;
        currentExamQuestions = generatePackageQuestionsFromLessons(packageType, lessonIdsArray);
      } else {
        selectedLessonId = parseInt(chosenLessonVal);
        const lessonMeta = LESSON_METADATA.find(l => l.id === selectedLessonId);
        lessonTitle = lessonMeta ? lessonMeta.title : `Bài ${selectedLessonId}`;
        activeUser.lessonId = selectedLessonId;
        activeUser.lessonTitle = lessonTitle;

        currentQuestions = getLessonQuestionBank(selectedLessonId);
        const pool = JSON.parse(JSON.stringify(currentQuestions));
        for (let i = pool.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [pool[i], pool[j]] = [pool[j], pool[i]];
        }
        pool.forEach(q => {
          if (q.type === 'MC' && Array.isArray(q.options)) {
            const originalCorrect = q.options[q.correct];
            for (let i = q.options.length - 1; i > 0; i--) {
              const j = Math.floor(Math.random() * (i + 1));
              [q.options[i], q.options[j]] = [q.options[j], q.options[i]];
            }
            q.correct = q.options.indexOf(originalCorrect);
          }
        });
        currentExamQuestions = pool;
