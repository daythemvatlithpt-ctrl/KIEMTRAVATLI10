    function generateLessonBank(lessonId) {
      const qList = [];
      const lesson = LESSON_METADATA.find(l => l.id === lessonId);
      const totalQ = lesson ? lesson.totalQuestions : 25;

      const lessonKnowledge = {
        1: {
          name: "Làm quen với Vật lí",
          mc: [
            { q: "Đối tượng nghiên cứu trọng tâm của Vật lí là gì?", a: "Các dạng vận động của vật chất và năng lượng", o: ["Các dạng vận động của vật chất và năng lượng", "Sự tiến hóa của các loài sinh vật", "Thành phần và cấu trúc các chất hóa học", "Cấu trúc địa tầng của Trái Đất"] },
