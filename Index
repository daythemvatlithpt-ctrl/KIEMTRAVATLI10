        if (isCurrent) cls += "bg-blue-600 text-white ring-2 ring-blue-300 scale-105";
        else if (isDone) cls += "bg-amber-400 text-slate-900";
        else cls += "bg-slate-200 text-slate-600";
        btn.className = cls;
        navContainer.appendChild(btn);
      });

