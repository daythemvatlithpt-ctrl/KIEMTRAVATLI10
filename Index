      document.getElementById('participant-display-name').textContent = nameDisp;
      document.getElementById('header-main-title').innerHTML = `${activeUser.lessonTitle} <span class="text-xs font-normal text-blue-200">| Lớp ${activeUser.className}</span>`;
      document.getElementById('welcome-user-heading').textContent = `Chúc mừng ${activeUser.name || ('Nhóm ' + activeUser.groupNum)} tham gia kiểm tra!`;
      document.getElementById('welcome-user-sub').textContent = `${activeUser.lessonTitle} - Thang điểm chuẩn 10.0`;

      SoundFx.playApplause();
      confetti({ particleCount: 80, spread: 80, origin: { y: 0.5 } });
      speakGreeting(`Chào mừng em tham gia kiểm tra. Chúc em làm bài thật tốt!`);

      if (isPackageMode) {
        timeRemaining = currentExamQuestions.length * 20;
        totalExamTime = timeRemaining;
        document.getElementById('btn-submit-exam').classList.add('hidden');
        renderPackageWorkspace();
      } else {
        timeRemaining = 1200;
        totalExamTime = 1200;
        document.getElementById('btn-submit-exam').classList.remove('hidden');
        renderStickyNav();
        renderExamQuestions();
        startCountdownTimer();
      }
    }

    function renderPackageWorkspace() {
      const container = document.getElementById('questions-container');
      container.innerHTML = '';
      document.getElementById('answered-count-indicator').textContent = `Tiến độ: ${currentQuestionIndex + 1}/${currentExamQuestions.length} câu`;

      const navContainer = document.getElementById('nav-question-pill-container');
      navContainer.innerHTML = '';
